# ===================== HeartCron 心时 环境变量示例 =====================
# 复制本文件为 .env 后按需修改：cp .env.example .env
# 登录账号密码只存放于 .env，不写入数据库

# 服务监听端口
PORT=8080

# 后台登录账号 / 密码（务必修改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=heartcron123

# session 加密密钥（生产环境请改成随机长字符串）
SESSION_SECRET=heartcron_session_secret_please_change_me

# session 有效期（毫秒），默认 7 天
SESSION_MAX_AGE=604800000

# ===================== MySQL 数据库配置 =====================
# 数据库主机地址（本机填 127.0.0.1）
DB_HOST=127.0.0.1
# 数据库端口，MySQL 默认 3306
DB_PORT=3306
# 数据库账号
DB_USER=root
# 数据库密码
DB_PASSWORD=
# 数据库名称（不存在时服务启动会自动创建）
DB_NAME=heartcron
# 连接池大小
DB_CONNECTION_LIMIT=10

# 定时任务时区
TZ=Asia/Shanghai

# 外部请求超时时间（毫秒）
HTTP_TIMEOUT=10000
